{"ticker": "BIRLAPREC.NS", "indexes": ["NSE"], "fetched_at": "2026-05-29T13:40:31.180779+00:00", "name": "Birla Precision Technologies Limited", "exchange": "NSI", "exchange_name": "NSE", "sector": "", "industry": "", "country": "India", "website": "https://www.birlaprecision.com", "summary": "Birla Precision Technologies Limited manufactures and sells machine tools and accessories, precision and automotive components, and castings in India, Japan, the United States, and internationally. It operates through Tooling, Automotive Components, and Other segments. The company offers tool holders, including collet, side lock, milling, shrink fit, dual taper, special, stub, extra gauge length, morse taper, turning tool, and mechanical holders; work and tool holding products; power grip milling chucks; production boosters; wooden box kits; boring bar adapters; jacobs tapers; drill chuck adapters; tapping systems; VDI shank tooling; reduction sleeves; hydraulic chucks; shrink-fit heating machines; collets; and accessories. It also provides cutting tools comprising solid carbide drills, solid carbide end mills, twist and center drills, reamers, bore and shank type milling cutters, screwing taps, tools bits, engineering files, and grooving tools, as well as duratool products, consisting of hammer, masonry, and H series drills; annular cutters; carbide tip drills; steel files; ultra-thin and chopsaw wheels; depressed center discs; and TCT circular saws. In addition, the company offers ferrous shell casting products, such as bearing and turbine housings; braking; engine parts; fuel system shafts; o-ring carriers; drive shafts; end parts for metallic bellows; flanges; hydraulic spools; hydraulic actuator cylinders; rocker arm levers; halter; end yokes; crank shafts; fork selectors; machinery application; and turbocharger components for railways. It sells its products under the Dagger, Hathyar, Ninja, Panther and Carbomach brands. The company exports its products to China, Germany, the Czech Republic, Europe, and the Asia Pacific. The company was formerly known as Birla Kennametal Limited and changed its name to Birla Precision Technologies Limited in November 2007. Birla Precision Technologies Limited was founded in 1937 and is based in Mumbai, India.", "market_cap": null, "enterprise_value": 3215910912, "pe_trailing": null, "pe_forward": null, "eps_trailing": null, "eps_forward": null, "peg": null, "ps": null, "pb": 1.8117676, "ev_ebitda": 12.944, "dividend_yield": null, "payout_ratio": null, "beta": 0.284, "roe": null, "roa": null, "profit_margin": 0.05406, "operating_margin": -0.01779, "gross_margin": 0.67271006, "revenue_growth": 0.013, "earnings_growth": 0.571, "debt_to_equity": 27.266, "current_ratio": null, "quick_ratio": null, "book_value": 25.511, "total_debt": 476444992, "total_cash": 240078000, "free_cashflow": null, "operating_cashflow": null, "total_revenue": 2351132928, "ebitda": 248440992, "shares_outstanding": null, "employees": 638, "analyst_target": null, "analyst_target_high": null, "analyst_target_low": null, "analyst_target_median": null, "analyst_count": null, "recommendation_mean": null, "recommendation": "none", "derived": {"price": 46.22, "high_52w": 47.0, "low_52w": 33.35, "pct_from_high": -1.66, "pct_from_low": 38.59, "ytd_change": 31.87, "ret_1m": 33.58, "rsi_14": 72.39, "avg_vol_30d": 124753}, "history": [{"d": "2026-04-20", "o": 34.5, "h": 35.5, "l": 33.2, "c": 35.05, "v": 12833}, {"d": "2026-04-21", "o": 35.05, "h": 38.95, "l": 33.55, "c": 36.05, "v": 44645}, {"d": "2026-04-22", "o": 37.2, "h": 37.2, "l": 34.25, "c": 35.0, "v": 40200}, {"d": "2026-04-23", "o": 36.85, "h": 36.85, "l": 35.1, "c": 35.4, "v": 7942}, {"d": "2026-04-24", "o": 35.0, "h": 36.8, "l": 32.25, "c": 33.35, "v": 40644}, {"d": "2026-04-27", "o": 33.5, "h": 34.9, "l": 33.5, "c": 33.95, "v": 12839}, {"d": "2026-04-28", "o": 35.75, "h": 35.75, "l": 34.1, "c": 34.6, "v": 6597}, {"d": "2026-04-29", "o": 34.8, "h": 35.8, "l": 34.1, "c": 34.55, "v":