dditive manufacturing, aerospace, automotive, construction, defense, general engineering, medical, mining, oil and gas, and process industries. The company was incorporated in 1964 and is based in Bengaluru, India. Kennametal India Limited is a subsidiary of Meturit AG.", "market_cap": 63640195072, "enterprise_value": 63392481280, "pe_trailing": 45.852734, "pe_forward": 39.774723, "eps_trailing": 63.15, "eps_forward": 72.8, "peg": null, "ps": 4.6914997, "pb": 7.933216, "ev_ebitda": 28.688, "dividend_yield": 1.35, "payout_ratio": 0.0, "beta": 0.42, "roe": null, "roa": null, "profit_margin": 0.1021, "operating_margin": 0.16075, "gross_margin": 0.44090998, "revenue_growth": 0.392, "earnings_growth": 1.104, "debt_to_equity": 0.262, "current_ratio": null, "quick_ratio": null, "book_value": 364.997, "total_debt": 21000000, "total_cash": 1794000000, "free_cashflow": null, "operating_cashflow": null, "total_revenue": 13564999680, "ebitda": 2209750016, "shares_outstanding": 21978240, "employees": 772, "analyst_target": 3153.0, "analyst_target_high": 3153.0, "analyst_target_low": 3153.0, "analyst_target_median": 3153.0, "analyst_count": 1, "recommendation_mean": null, "recommendation": "none", "derived": {"price": 2895.6, "high_52w": 3086.61, "low_52w": 2430.57, "pct_from_high": -6.19, "pct_from_low": 19.13, "ytd_change": 18.52, "ret_1m": 8.74, "rsi_14": 54.92, "avg_vol_30d": 14846}, "history": [{"d": "2026-04-15", "o": 2443.1008, "h": 2443.1008, "l": 2443.1008, "c": 2443.1008, "v": 0}, {"d": "2026-04-16", "o": 2443.1008, "h": 2443.1008, "l": 2443.1008, "c": 2443.1008, "v": 0}, {"d": "2026-04-17", "o": 2443.1008, "h": 2443.1008, "l": 2443.1008, "c": 2443.1008, "v": 0}, {"d": "2026-04-20", "o": 2443.1008, "h": 2443.1008, "l": 2443.1008, "c": 2443.1008, "v": 0}, {"d": "2026-04-21", "o": 2443.1008, "h": 2443.1008, "l": 2443.1008, "c": 2443.1008, "v": 0}, {"d": "2026-04-22", "o": 2443.1008, "h": 2443.1008, "l": 2443.1008, "c": 2443.1008, "v": 0}, {"d": "2026-04-23", "o": 2511.082